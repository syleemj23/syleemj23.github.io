{% assign current_lang = page.lang | default: site.lang | default: 'ko' %}
{% if current_lang == 'en' %}
  {% assign home_url = '/en/' %}
  {% assign menu_titles = 'About|Projects|Notes' | split: '|' %}
  {% assign menu_urls = '/en/|/en/projects/|/en/blog/' | split: '|' %}
  {% assign switch_url = page.translation_url | default: '/' %}
  {% assign switch_label = '한국어' %}
  {% assign switch_lang = 'ko' %}
{% else %}
  {% assign home_url = '/' %}
  {% assign menu_titles = '소개|프로젝트|지식창고' | split: '|' %}
  {% assign menu_urls = '/|/projects/|/blog/' | split: '|' %}
  {% assign switch_url = page.translation_url | default: '/en/' %}
  {% assign switch_label = 'English' %}
  {% assign switch_lang = 'en' %}
{% endif %}
<style>
  #navbar .nav-tools-start {
    margin-inline-start: 1rem;
    padding-inline-start: 1rem;
    border-inline-start: 1px solid rgba(128, 128, 128, 0.28);
    align-self: center;
  }
  #navbar .language-menu + .toggle-container {
    margin-inline-start: 0.5rem;
  }
  @media (max-width: 575.98px) {
    #navbar .nav-tools-start {
      margin-inline-start: 0;
      padding-inline-start: 0;
      border-inline-start: 0;
      align-self: flex-start;
    }
  }
  #navbar .language-menu {
    margin-inline-start: 0.5rem;
    padding-inline-start: 0;
    border-inline-start: 0;
    align-self: center;
  }
  #navbar .language-menu > .language-selector {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(128, 128, 128, 0.4);
    border-radius: 999px;
    background: rgba(128, 128, 128, 0.08);
    color: var(--global-text-color, inherit);
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    text-decoration: none;
  }
  #navbar .language-selector:hover,
  #navbar .language-selector[aria-expanded="true"] {
    background: rgba(128, 128, 128, 0.18);
    border-color: currentColor;
  }
  #navbar .language-selector:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  #navbar .language-selector svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  #navbar .language-menu > .dropdown-menu {
    min-width: 9rem;
    margin-top: 0.5rem;
    padding: 0.35rem;
    border-radius: 0.75rem;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
  }
  #navbar .language-menu .dropdown-item {
    border-radius: 0.4rem;
  }
  @media (max-width: 575.98px) {
    #navbar .language-menu {
      align-self: flex-start;
      margin-inline-start: 0;
      padding-inline-start: 0;
      border-inline-start: 0;
      margin-block: 0.5rem;
    }
  }
</style>
<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.url != home_url %}
        <a class="navbar-brand title font-weight-lighter" href="{{ home_url | relative_url }}">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% for label in menu_titles %}
            {% assign menu_url = menu_urls[forloop.index0] %}
            {% assign is_active = false %}
            {% if page.url == menu_url %}
              {% assign is_active = true %}
            {% elsif forloop.first == false and page.url contains menu_url %}
              {% assign is_active = true %}
            {% endif %}
            <li class="nav-item {% if is_active %}active{% endif %}">
              <a class="nav-link" href="{{ menu_url | relative_url }}" {% if is_active %}aria-current="page"{% endif %}>{{ label }}</a>
            </li>
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item nav-tools-start">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if current_lang == 'en' %}
            {% assign korean_url = switch_url %}
            {% assign english_url = page.url %}
          {% else %}
            {% assign korean_url = page.url %}
            {% assign english_url = switch_url %}
          {% endif %}
          <li class="nav-item dropdown language-menu">
            <a
              class="nav-link dropdown-toggle language-selector"
              href="#"
              id="languageDropdown"
              role="button"
              data-nav-dropdown-toggle="true"
              aria-haspopup="true"
              aria-controls="languageDropdownMenu"
              aria-expanded="false"
              aria-label="{% if current_lang == 'en' %}Select language{% else %}언어 선택{% endif %}"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="9"></circle>
                <ellipse cx="12" cy="12" rx="4" ry="9"></ellipse>
                <path d="M3 12h18M5 7h14M5 17h14"></path>
              </svg>
              <span>{% if current_lang == 'en' %}English{% else %}한국어{% endif %}</span>
            </a>
            <div class="dropdown-menu dropdown-menu-right" id="languageDropdownMenu" aria-labelledby="languageDropdown">
              <a class="dropdown-item {% if current_lang != 'en' %}active{% endif %}" href="{{ korean_url | relative_url }}" lang="ko" hreflang="ko" {% if current_lang != 'en' %}aria-current="page"{% endif %}>한국어</a>
              <a class="dropdown-item {% if current_lang == 'en' %}active{% endif %}" href="{{ english_url | relative_url }}" lang="en" hreflang="en" {% if current_lang == 'en' %}aria-current="page"{% endif %}>English</a>
            </div>
          </li>
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>



