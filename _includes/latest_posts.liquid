{% assign latest_language = page.lang | default: site.lang | default: 'ko' %}
{% assign language_posts = site.posts | where: 'lang', latest_language | sort: 'date' | reverse %}
{% assign latest_limit = page.latest_posts.limit | default: language_posts.size %}
<div class="news">
  {% if language_posts.size > 0 %}
    <div class="table-responsive" {% if page.latest_posts.scrollable and language_posts.size > 3 %}style="max-height: 60vw"{% endif %}>
      <table class="table table-sm table-borderless">
        <tbody>
          {% for entry in language_posts limit: latest_limit %}
            <tr>
              <th scope="row" style="width: 20%">
                {% if latest_language == 'ko' %}
                  {{ entry.date | date: '%Y년 %m월 %d일' }}
                {% else %}
                  {{ entry.date | date: '%b %d, %Y' }}
                {% endif %}
              </th>
              <td>
                {% if entry.redirect == blank %}
                  <a class="news-title" href="{{ entry.url | relative_url }}">{{ entry.title | escape }}</a>
                {% elsif entry.redirect contains '://' %}
                  <a class="news-title" href="{{ entry.redirect | escape }}" target="_blank" rel="noopener noreferrer">{{ entry.title | escape }}</a>
                {% else %}
                  <a class="news-title" href="{{ entry.redirect | relative_url }}">{{ entry.title | escape }}</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <p>{% if latest_language == 'ko' %}아직 등록된 한국어 글이 없습니다.{% else %}No English posts yet.{% endif %}</p>
  {% endif %}
</div>
